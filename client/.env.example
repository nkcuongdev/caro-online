# URL of the deployed game server (Railway / Render). Leave empty in local dev:
# Vite proxies /socket.io and /api to http://localhost:4000.
VITE_SOCKET_URL=
VITE_API_URL=
# Optional: public origin used for invite links (defaults to window.location.origin).
VITE_PUBLIC_URL=
# Optional: ICE servers for voice chat (JSON array of RTCIceServer). Defaults to public STUN.
# Add a TURN server if players sit behind strict NATs, e.g.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
VITE_ICE_SERVERS=
