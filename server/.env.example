# Port to listen on (Railway/Render inject PORT automatically)
PORT=4000
# Comma-separated list of allowed browser origins. Wildcards allowed, e.g. https://*.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Game timing (optional)
TURN_SECONDS=30
START_COUNTDOWN_SECONDS=3
DISCONNECT_FORFEIT_SECONDS=60
MOVE_GRACE_MS=300
ROOM_IDLE_MINUTES=15
# Guest avatar uploads. With Cloudinary configured, uploads go there; otherwise
# they are written to AVATAR_UPLOAD_DIR (wiped on redeploy unless it sits on a persistent disk).
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=caro/avatars
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_MAX_KB=1024
AVATAR_UPLOADS_PER_10_MIN=10
# Voice chat TURN relay (optional). Without it, calls use public STUN only and fail
# between some networks (4G carrier NAT, strict Wi-Fi). Credentials are handed only
# to seated players over the socket, never baked into the frontend.
# Either a fixed login from the Metered dashboard (TURN_URLS defaults to Metered's relay):
TURN_USERNAME=
TURN_CREDENTIAL=
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
# ...or expiring credentials minted with a Metered TURN secret key (takes precedence;
# METERED_API_KEY also works in place of the secret key):
# METERED_DOMAIN=yourapp.metered.live
# METERED_SECRET_KEY=
# METERED_CREDENTIAL_HOURS=6
# Accounts (SQLite through libSQL). In production: a Turso database, whose URL and token come
# from the Turso dashboard. Leave DATABASE_URL empty in development to use the local file
# DATABASE_PATH instead (the dev seed script only ever touches that local file).
DATABASE_URL=
# DATABASE_URL=libsql://caro-online-<org>.turso.io
DATABASE_AUTH_TOKEN=
DATABASE_PATH=data/caro.db
# Unset: a random key is generated once and kept in the database.
JWT_SECRET=
AUTH_SESSION_DAYS=30
AUTH_ATTEMPTS_PER_10_MIN=20
# Tournaments (optional)
TOURNAMENT_READY_SECONDS=30
TOURNAMENT_START_DELAY_SECONDS=5
TOURNAMENT_NEXT_GAME_SECONDS=6
TOURNAMENT_IDLE_MINUTES=30
